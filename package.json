{
  "name": "exetron",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/run-turbo.mjs build",
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs --mobile",
    "dev:mobile": "node scripts/dev.mjs --mobile-only",
    "lint": "node scripts/run-turbo.mjs lint",
    "typecheck": "node scripts/run-turbo.mjs typecheck",
    "test": "node scripts/run-turbo.mjs test",
    "test:e2e": "node scripts/run-turbo.mjs test:e2e",
    "test:critical": "node scripts/run-turbo.mjs test:e2e",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down -v",
    "db:generate": "node scripts/run-pnpm.mjs --filter @exetron/database db:generate",
    "db:migrate": "node scripts/run-pnpm.mjs --filter @exetron/database db:migrate",
    "db:deploy": "node scripts/run-pnpm.mjs --filter @exetron/database db:deploy",
    "db:seed": "node scripts/run-pnpm.mjs --filter @exetron/database db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.14",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
