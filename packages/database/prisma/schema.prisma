generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum DeviceType {
  POS
  KIOSK
  KITCHEN
  BOARD
  BACKOFFICE
}

enum DeviceStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RETIRED
}

enum AuditActorType {
  USER
  SYSTEM
  DEVICE
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum FeatureFlagKind {
  BOOLEAN
  PERCENTAGE
}

enum CustomizationChannel {
  ADMIN
  POS
  KIOSK
  DELIVERY
  KITCHEN
  BOARD
  BACKOFFICE
}

enum CustomizationRuleStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ModifierGroupStatus {
  ACTIVE
  ARCHIVED
}

enum ModifierOptionStatus {
  ACTIVE
  ARCHIVED
}

enum ModifierSelectionMode {
  SINGLE
  MULTIPLE
}

enum PriceListStatus {
  ACTIVE
  ARCHIVED
}

enum CatalogTargetType {
  PRODUCT
  VARIANT
  MODIFIER_OPTION
}

enum AvailabilityTargetType {
  PRODUCT
  VARIANT
}

enum OrderChannel {
  ADMIN
  POS
  KIOSK
  DELIVERY
}

enum CartStatus {
  OPEN
  CONVERTED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  IN_PREPARATION
  READY
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  NONE
  NOT_REQUIRED
  PENDING_MANUAL
}

enum CustomerProfileStatus {
  ACTIVE
  MERGED
  ARCHIVED
}

enum LoyaltyLedgerEntryKind {
  EARN
  REDEEM
  ADJUST
}

enum PromotionStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  LOYALTY_REDEEM
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

enum PosSessionStatus {
  ACTIVE
  ENDED
}

enum PaymentMethodKind {
  CASH
  CARD
  QR
}

enum PaymentIntentStatus {
  PENDING
  PARTIALLY_PAID
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentAllocationStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentProviderType {
  CASH_MANUAL
  CARD_SIMULATED
  QR_SIMULATED
}

enum KitchenTicketStatus {
  NEW
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum KioskPaymentHandoffStatus {
  INITIATED
  COMPLETED
  FAILED
  CANCELLED
}

model Tenant {
  id                   String                 @id @default(uuid()) @db.Uuid
  slug                 String                 @unique
  name                 String
  status               TenantStatus           @default(ACTIVE)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  brands               Brand[]
  stores               Store[]
  users                User[]
  roles                Role[]
  devices              Device[]
  auditLogs            AuditLog[]
  featureFlags         FeatureFlag[]
  brandingConfigs      CustomizationBrandingConfig[]
  customizationRules   CustomizationRule[]
  tenantSettings       TenantSetting[]
  storeSettings        StoreSetting[]
  outboxEvents         OutboxEvent[]
  categories           Category[]
  products             Product[]
  productVariants      ProductVariant[]
  modifierGroups       ModifierGroup[]
  modifierOptions      ModifierOption[]
  productModifierLinks ProductModifierGroup[]
  priceLists           PriceList[]
  priceListItems       PriceListItem[]
  storeCatalogOverrides StoreCatalogOverride[]
  availabilityWindows  AvailabilityWindow[]
  carts                Cart[]
  orders               Order[]
  orderEvents          OrderEvent[]
  posShifts            PosShift[]
  posSessions          PosSession[]
  paymentIntents       PaymentIntent[]
  paymentAllocations   PaymentAllocation[]
  paymentAttempts      PaymentAttempt[]
  paymentProviderConfigs PaymentProviderConfig[]
  analyticsSnapshots   AnalyticsSnapshot[]
  kitchenTickets       KitchenTicket[]
  kioskPaymentHandoffs KioskPaymentHandoff[]
  customerProfiles     CustomerProfile[]
  loyaltyAccounts      LoyaltyAccount[]
  loyaltyLedgerEntries LoyaltyLedgerEntry[]
  promotionCampaigns   PromotionCampaign[]
}

model Brand {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  code      String
  name      String
  status    BrandStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stores    Store[]
  products  Product[]

  @@unique([tenantId, code])
}

model Store {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @db.Uuid
  brandId             String?                @db.Uuid
  code                String
  name                String
  timezone            String                 @default("UTC")
  status              StoreStatus            @default(ACTIVE)
  address             Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand               Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  devices             Device[]
  storeSettings       StoreSetting[]
  featureFlags        FeatureFlag[]
  brandingConfigs     CustomizationBrandingConfig[]
  customizationRules  CustomizationRule[]
  storeAccess         UserStoreAccess[]
  auditLogs           AuditLog[]
  catalogOverrides    StoreCatalogOverride[]
  availabilityWindows AvailabilityWindow[]
  carts               Cart[]
  orders              Order[]
  orderEvents         OrderEvent[]
  posShifts           PosShift[]
  posSessions         PosSession[]
  paymentIntents      PaymentIntent[]
  paymentAttempts     PaymentAttempt[]
  paymentProviderConfigs PaymentProviderConfig[]
  analyticsSnapshots  AnalyticsSnapshot[]
  kitchenTickets      KitchenTicket[]
  kioskPaymentHandoffs KioskPaymentHandoff[]
  customerProfiles    CustomerProfile[]       @relation("StoreCustomerProfiles")
  promotionCampaigns  PromotionCampaign[]

  @@unique([tenantId, code])
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String?          @db.Uuid
  email           String           @unique
  firstName       String
  lastName        String
  passwordHash    String
  status          UserStatus       @default(ACTIVE)
  isPlatformAdmin Boolean          @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  refreshSessions RefreshSession[]
  userRoles       UserRole[]
  storeAccess     UserStoreAccess[]
  createdCarts    Cart[]           @relation("CartCreatedByUser")
  createdOrders   Order[]          @relation("OrderCreatedByUser")
  openedPosShifts PosShift[]       @relation("PosShiftOpenedByUser")
  posSessions     PosSession[]
  paymentIntents  PaymentIntent[]  @relation("PaymentIntentCreatedByUser")
  analyticsSnapshots AnalyticsSnapshot[] @relation("AnalyticsSnapshotCreatedByUser")

  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roleLinks   RolePermission[]
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  key         String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserStoreAccess {
  userId     String   @db.Uuid
  storeId    String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

model Device {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  storeId    String       @db.Uuid
  code       String
  name       String
  type       DeviceType
  status     DeviceStatus @default(PENDING)
  apiKeyHash String?
  lastSeenAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  carts      Cart[]
  orders     Order[]
  paymentIntents PaymentIntent[]
  posShifts  PosShift[]
  posSessions PosSession[]
  kioskPaymentHandoffs KioskPaymentHandoff[]

  @@unique([tenantId, code])
}

model RefreshSession {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  tokenHash  String        @unique
  status     SessionStatus @default(ACTIVE)
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  metadata   Json?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String?        @db.Uuid
  storeId    String?        @db.Uuid
  actorType  AuditActorType
  actorId    String
  action     String
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime       @default(now())
  tenant     Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  store      Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([storeId, createdAt])
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model StoreSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  storeId   String   @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
}

model FeatureFlag {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  storeId           String?         @db.Uuid
  scopeKey          String
  key               String
  enabled           Boolean         @default(false)
  kind              FeatureFlagKind @default(BOOLEAN)
  rolloutPercentage Int?
  rules             Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, key])
  @@index([tenantId, storeId])
}

model CustomizationBrandingConfig {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid
  storeId   String?              @db.Uuid
  channel   CustomizationChannel
  pointKey  String?
  scopeKey  String               @unique
  config    Json
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store?               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel, createdAt])
  @@index([storeId, channel, createdAt])
}

model CustomizationRule {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  storeId     String?                 @db.Uuid
  channel     CustomizationChannel?
  pointKey    String?
  key         String
  description String?
  status      CustomizationRuleStatus @default(ACTIVE)
  priority    Int                     @default(100)
  conditions  Json?
  actions     Json
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store       Store?                  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, channel, status, priority])
  @@index([storeId, channel, status, priority])
}

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  eventName   String
  aggregate   String
  aggregateId String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([publishedAt])
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  parentId    String?        @db.Uuid
  code        String
  name        String
  description String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]     @relation("CategoryHierarchy")
  products    Product[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
}

model Product {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  categoryId        String?               @db.Uuid
  brandId           String?               @db.Uuid
  code              String
  name              String
  description       String?
  status            ProductStatus         @default(ACTIVE)
  isVisible         Boolean               @default(true)
  isAvailable       Boolean               @default(true)
  isOutOfStock      Boolean               @default(false)
  basePrice         Decimal?              @db.Decimal(12, 2)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand             Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  modifierGroupLinks ProductModifierGroup[]

  @@unique([tenantId, code])
  @@index([tenantId, categoryId])
}

model ProductVariant {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @db.Uuid
  productId          String               @db.Uuid
  code               String
  name               String
  sku                String?
  barcode            String?
  status             ProductStatus        @default(ACTIVE)
  isVisible          Boolean              @default(true)
  isAvailable        Boolean              @default(true)
  isOutOfStock       Boolean              @default(false)
  basePrice          Decimal?             @db.Decimal(12, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
  @@index([tenantId, productId])
}

model ModifierGroup {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  code          String
  name          String
  description   String?
  selectionMode ModifierSelectionMode @default(SINGLE)
  minSelection  Int                   @default(0)
  maxSelection  Int?
  required      Boolean               @default(false)
  status        ModifierGroupStatus   @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  options       ModifierOption[]
  productLinks  ProductModifierGroup[]

  @@unique([tenantId, code])
}

model ModifierOption {
  id         String               @id @default(uuid()) @db.Uuid
  tenantId   String               @db.Uuid
  groupId    String               @db.Uuid
  code       String
  name       String
  status     ModifierOptionStatus @default(ACTIVE)
  priceDelta Decimal              @default(0) @db.Decimal(12, 2)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group      ModifierGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, code])
  @@index([tenantId, groupId])
}

model ProductModifierGroup {
  tenantId        String        @db.Uuid
  productId       String        @db.Uuid
  modifierGroupId String        @db.Uuid
  sortOrder       Int           @default(0)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@index([tenantId, modifierGroupId])
}

model PriceList {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  code      String
  name      String
  currency  String
  status    PriceListStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     PriceListItem[]

  @@unique([tenantId, code])
}

model PriceListItem {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  priceListId String           @db.Uuid
  targetType CatalogTargetType
  targetId   String            @db.Uuid
  price      Decimal           @db.Decimal(12, 2)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList  PriceList         @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, targetType, targetId])
  @@index([tenantId, targetType, targetId])
}

model StoreCatalogOverride {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  storeId      String            @db.Uuid
  targetType   CatalogTargetType
  targetId     String            @db.Uuid
  isVisible    Boolean?
  isAvailable  Boolean?
  isOutOfStock Boolean?
  priceOverride Decimal?         @db.Decimal(12, 2)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, targetType, targetId])
  @@index([tenantId, storeId])
}

model AvailabilityWindow {
  id         String                 @id @default(uuid()) @db.Uuid
  tenantId   String                 @db.Uuid
  storeId    String?                @db.Uuid
  targetType AvailabilityTargetType
  targetId   String                 @db.Uuid
  weekday    Int
  startTime  String
  endTime    String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store      Store?                 @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId, targetType, targetId])
  @@index([storeId, weekday])
}

model CustomerProfile {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  preferredStoreId String?               @db.Uuid
  fullName         String?
  phone            String
  phoneNormalized  String
  status           CustomerProfileStatus @default(ACTIVE)
  orderCount       Int                   @default(0)
  completedOrderCount Int                @default(0)
  totalSpent       Decimal               @default(0) @db.Decimal(12, 2)
  lastOrderAt      DateTime?
  lastSeenAt       DateTime?
  segments         Json?
  retentionState   Json?
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferredStore   Store?                @relation("StoreCustomerProfiles", fields: [preferredStoreId], references: [id], onDelete: SetNull)
  loyaltyAccount   LoyaltyAccount?
  loyaltyLedgerEntries LoyaltyLedgerEntry[]
  carts            Cart[]
  orders           Order[]

  @@unique([tenantId, phoneNormalized])
  @@index([tenantId, preferredStoreId, status])
  @@index([tenantId, lastOrderAt])
}

model LoyaltyAccount {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @db.Uuid
  customerProfileId  String          @db.Uuid @unique
  pointsBalance      Int             @default(0)
  totalEarnedPoints  Int             @default(0)
  totalRedeemedPoints Int            @default(0)
  tierKey            String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerProfile    CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  entries            LoyaltyLedgerEntry[]

  @@index([tenantId, pointsBalance])
}

model LoyaltyLedgerEntry {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  customerProfileId String                @db.Uuid
  loyaltyAccountId  String                @db.Uuid
  orderId           String?               @db.Uuid
  entryKind         LoyaltyLedgerEntryKind
  points            Int
  amount            Decimal?              @db.Decimal(12, 2)
  description       String?
  metadata          Json?
  createdAt         DateTime              @default(now())
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerProfile   CustomerProfile       @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  loyaltyAccount    LoyaltyAccount        @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  order             Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, entryKind])
  @@index([tenantId, customerProfileId, createdAt])
}

model PromotionCampaign {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  storeId           String?          @db.Uuid
  code              String
  name              String
  status            PromotionStatus  @default(ACTIVE)
  type              PromotionType
  value             Decimal          @db.Decimal(12, 2)
  minimumOrderTotal Decimal          @default(0) @db.Decimal(12, 2)
  maxDiscountAmount Decimal?         @db.Decimal(12, 2)
  pointsCost        Int?
  segmentKeys       String[]         @default([])
  usageLimit        Int?
  usedCount         Int              @default(0)
  activeFrom        DateTime?
  activeTo          DateTime?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, storeId, status, activeFrom, activeTo])
}

model Cart {
